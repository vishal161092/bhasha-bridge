# Port the Express server listens on (Heroku sets this automatically)
PORT=3000
# Bhashini (Dhruva) API key used for ASR / translation / TTS
BHASHINI_API_KEY=
# Salesforce My Domain URL, e.g. https://your-domain.my.salesforce.com
SF_ORG_DOMAIN=
# External Client App consumer key / secret (OAuth 2.0 client-credentials flow enabled)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
# Agentforce agent (PD_Agent) Id used for the Agent API session
SF_AGENT_ID=
# Default Contact Id used by the demo UI when none is passed (?id=)
SF_CONTACT_ID=
