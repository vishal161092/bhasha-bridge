<?xml version="1.0" encoding="UTF-8"?>
<!-- TEMPLATE: after deploying, open Setup > Named Credentials > External Credentials > Bhashini_EC,
     edit the "Bhashini_Principal" principal and add an Authentication Parameter named ApiKey whose
     value is your Bhashini (Dhruva) API key. The secret is never stored in source. -->
<ExternalCredential xmlns="http://soap.sforce.com/2006/04/metadata">
    <authenticationProtocol>Custom</authenticationProtocol>
    <externalCredentialParameters>
        <parameterGroup>Bhashini_Principal</parameterGroup>
        <parameterName>Bhashini_Principal</parameterName>
        <parameterType>NamedPrincipal</parameterType>
        <sequenceNumber>1</sequenceNumber>
    </externalCredentialParameters>
    <label>Bhashini External Credential</label>
</ExternalCredential>
