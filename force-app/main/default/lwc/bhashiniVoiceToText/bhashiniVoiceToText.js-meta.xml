<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Bhashini Voice to Text</masterLabel>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="language" label="Language" type="String" default="hi" datasource="en,hi,bn,gu,mr,ta,te" description="Language code of the speech to transcribe"/>
            <property name="labelName" label="Label Name" type="String"/>
            <property name="textBox" label="Use multi-line text area" type="Boolean"/>
        </targetConfig>
        <targetConfig targets="lightning__FlowScreen">
            <property name="language" label="Language (en, hi, bn, gu, mr, ta, te)" type="String" default="hi"/>
            <property name="labelName" label="Label Name" type="String"/>
            <property name="textBox" label="TextBox" type="Boolean"/>
            <property name="transcriptionText" label="Output" type="String"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
